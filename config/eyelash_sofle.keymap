/*
 * ZMK keymap for PandaKB Eyelash Sofle (nice!nano v2)
 * Coding-optimized layout.
 *
 * HARDWARE (from PandaKB Sofle-J / Eyelash):
 *   - Left half: EC11 rotary encoder -> ZMK sensor (volume/scroll)
 *   - Right half: 5-way joystick, wired as MATRIX KEYS in the inner column:
 *       UP    = matrix index 6   (RC(0,7))
 *       DOWN  = matrix index 19  (RC(1,7))
 *       LEFT  = matrix index 32  (RC(2,7))
 *       RIGHT = matrix index 45  (RC(3,7))
 *       PRESS = matrix index 58  (RC(4,7))
 *   - Left encoder press = matrix index 52 (RC(4,0))
 *
 * LAYERS:
 *   0 BASE   QWERTY, mods on thumbs, left encoder = volume
 *   1 SYM    code symbols, mod-morph brackets
 *   2 NAV    vim navigation + register macros
 *   3 SYS    bluetooth, output, rgb, reset, bootloader, soft off
 *
 * MATRIX (eyelash_sofle default_transform, 5 rows x 14 cols, col6 unused):
 *   13 / 13 / 13 / 13 / 12 = 64 positions.
 *
 *   idx 0-5   : L row0        idx 6  : JOY UP      idx 7-12  : R row0
 *   idx 13-18 : L row1        idx 19 : JOY DOWN    idx 20-25 : R row1
 *   idx 26-31 : L row2        idx 32 : JOY LEFT    idx 33-38 : R row2
 *   idx 39-44 : L row3        idx 45 : JOY RIGHT   idx 46-51 : R row3
 *   idx 52-57 : L thumbs      idx 58 : JOY PRESS   idx 59-63 : R thumbs
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        vim_yank: vim_yank {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES &kp PLUS &kp Y>;
        };

        vim_paste: vim_paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES &kp PLUS &kp P>;
        };

        vim_dd: vim_dd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp D>;
        };

        vim_yy: vim_yy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Y &kp Y>;
        };

        vim_ciw: vim_ciw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp I &kp W>;
        };

        vim_gg: vim_gg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp G>;
        };

        vim_visual: vim_visual {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp V>;
        };
    };

    behaviors {
        paren: paren_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp RPAR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        brack: brack_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp RBKT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        brace: brace_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBRC>, <&kp RBRC>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        angle: angle_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LT>, <&kp GT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        quote: quote_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp APOS>, <&kp DQT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ============ LAYER 0 : BASE ============ */
        base {
            display-name = "BASE";
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5      &kp UP       &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp QUESTION
&kp TAB    &kp Q       &kp W       &kp E       &kp R       &kp T    &kp DOWN     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSLH
&kp CAPS   &kp A       &kp S       &kp D       &kp F       &kp G    &kp LEFT     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp APOS
&kp LSHFT  &kp Z    &kp X    &kp C    &kp V    &kp B     &kp RIGHT    &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp MINUS
&kp C_MUTE &kp LCTRL &kp LGUI &kp LALT &kp SPACE &mo 1       &kp ENTER &kp BSPC   &kp ENTER &mo 2   &mo 3  &kp RSHFT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* ============ LAYER 1 : SYMBOLS ============ */
        symbols {
            display-name = "SYM";
            bindings = <
&kp GRAVE  &kp F1    &kp F2    &kp F3    &kp F4    &kp F5                                &kp UP       &kp F6       &kp F7    &kp F8       &kp F9    &kp F10   &kp F11
&kp TILDE  &trans    &kp EXCL  &kp AT    &kp HASH  &kp DLLR                              &kp DOWN     &kp PRCNT    &kp CARET &kp AMPS     &kp STAR  &kp LPAR  &kp RPAR
&kp PIPE   &kp EQUAL &kp PLUS  &kp MINUS &paren    &brack                               &kp LEFT     &brace       &angle    &kp COLON    &kp SEMI  &kp DQT   &kp APOS
&trans     &trans    &kp COMMA &kp DOT   &kp BSLH  &kp DEL                               &kp RIGHT    &kp GRAVE    &kp TILDE &kp UNDER    &kp HOME  &quote    &trans
&trans     &trans    &trans    &trans    &trans    &trans                               &trans       &trans       &trans    &trans       &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* ============ LAYER 2 : NAVIGATION / VIM ============ */
        nav {
            display-name = "NAV";
            bindings = <
&kp GRAVE  &kp F1    &kp F2    &kp F3    &kp F4    &kp F5      &kp UP       &vim_yy   &kp PG_UP &kp HOME  &kp UP    &kp END   &kp PG_DN
&kp ESC    &trans    &trans    &trans    &trans    &trans       &kp DOWN     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp APOS
&kp LCTRL  &vim_gg   &vim_ciw  &vim_yank &vim_paste &vim_dd     &kp LEFT     &trans    &trans    &trans    &trans    &trans    &trans
&kp LSHFT  &trans    &trans    &trans    &trans    &trans       &kp RIGHT    &kp LC(FSLH) &kp LC(F) &kp LC(S) &kp LC(B) &kp LC(LS(P)) &trans
&trans     &trans    &trans    &trans    &trans    &trans       &trans       &trans    &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* ============ LAYER 3 : SYSTEM ============ */
        sys {
            display-name = "SYS";
            bindings = <
&trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp UP     &bt BT_CLR &bt BT_CLR_ALL &kp F6 &kp F7 &kp F8 &kp F9
&trans     &out OUT_USB &out OUT_BLE &trans       &trans       &trans       &kp DOWN   &trans     &trans         &trans  &trans  &trans  &kp F10
&trans     &sys_reset  &bootloader  &trans       &trans       &trans       &kp LEFT   &trans     &trans         &trans  &trans  &trans  &kp F11
&trans     &soft_off   &rgb_ug RGB_OFF &rgb_ug RGB_ON &rgb_ug RGB_EFF &rgb_ug RGB_BRI &kp RIGHT &trans &trans &trans &trans &rgb_ug RGB_BRD &kp F12
&trans     &trans      &trans        &trans       &trans       &trans       &trans     &trans     &trans         &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
