/*
 * ZMK keymap for PandaKB Eyelash Sofle (nice!nano v2)
 * Coding-optimized layout.
 *
 * HARDWARE (from PandaKB Sofle-J / Eyelash):
 *   - Left half: EC11 rotary encoder -> ZMK sensor (volume/scroll)
 *   - Right half: 5-way joystick, wired as MATRIX KEYS in the inner column:
 *       UP    = matrix index 6   (RC(0,7))
 *       DOWN  = matrix index 19  (RC(1,7))
 *       LEFT  = matrix index 32  (RC(2,7))
 *       RIGHT = matrix index 45  (RC(3,7))
 *       PRESS = matrix index 58  (RC(4,7))
 *   - Left encoder press = matrix index 52 (RC(4,0))
 *
 * LAYERS:
 *   0 BASE   QWERTY, mods on thumbs, left encoder = volume
 *   1 SYM    every symbol as one keypress (no Shift), F1-F12, brackets on right home
 *   2 NAV    vim text objects, motions, search, jump list, VS Code shortcuts
 *   3 SYS    bluetooth, output, media, brightness, screenshot, rgb, reset/boot
 *
 * MATRIX (eyelash_sofle default_transform, 5 rows x 14 cols, col6 unused):
 *   13 / 13 / 13 / 13 / 12 = 64 positions.
 *
 *   idx 0-5   : L row0        idx 6  : JOY UP      idx 7-12  : R row0
 *   idx 13-18 : L row1        idx 19 : JOY DOWN    idx 20-25 : R row1
 *   idx 26-31 : L row2        idx 32 : JOY LEFT    idx 33-38 : R row2
 *   idx 39-44 : L row3        idx 45 : JOY RIGHT   idx 46-51 : R row3
 *   idx 52-57 : L thumbs      idx 58 : JOY PRESS   idx 59-63 : R thumbs
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        /* ---- registers / editing ---- */
        vim_yank: vim_yank {                     /* "+y */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp PLUS &kp Y>;
        };

        vim_paste: vim_paste {                   /* "+p */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp PLUS &kp P>;
        };

        vim_blackhole_d: vim_blackhole_d {       /* "_d */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp UNDER &kp D>;
        };

        vim_ciw: vim_ciw {                       /* ciw */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp I &kp W>;
        };

        /* ---- text objects ---- */
        vim_ci_dq: vim_ci_dq {                   /* ci" */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp I &kp DQT>;
        };

        vim_ci_sq: vim_ci_sq {                   /* ci' */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp I &kp APOS>;
        };

        vim_ci_paren: vim_ci_paren {             /* ci( */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp I &kp LPAR>;
        };

        vim_ci_brack: vim_ci_brack {             /* ci[ */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp I &kp LBKT>;
        };

        vim_ci_brace: vim_ci_brace {             /* ci{ */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp I &kp LBRC>;
        };

        vim_va_brace: vim_va_brace {             /* va{ */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp V &kp A &kp LBRC>;
        };

        /* ---- motions ---- */
        vim_meth_prev: vim_meth_prev {           /* [m */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp M>;
        };

        vim_meth_next: vim_meth_next {           /* ]m */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RBKT &kp M>;
        };

        vim_fn_prev: vim_fn_prev {               /* [[ */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp LBKT>;
        };

        vim_fn_next: vim_fn_next {               /* ]] */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RBKT &kp RBKT>;
        };

        vim_change_prev: vim_change_prev {       /* g; */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp SEMI>;
        };

        vim_change_next: vim_change_next {       /* g, */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp COMMA>;
        };

        /* ---- indent / substitute ---- */
        vim_indent: vim_indent {                 /* >> */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GT &kp GT>;
        };

        vim_outdent: vim_outdent {               /* << */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp LT>;
        };

        vim_subst: vim_subst {                   /* :%s/ */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp PRCNT &kp S &kp FSLH>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ============ LAYER 0 : BASE ============ */
        base {
            display-name = "BASE";
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5      &kp UP       &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp QUESTION
&kp TAB    &kp Q       &kp W       &kp E       &kp R       &kp T    &kp DOWN     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSLH
&kp CAPS   &kp A       &kp S       &kp D       &kp F       &kp G    &kp LEFT     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp APOS
&kp LSHFT  &kp Z    &kp X    &kp C    &kp V    &kp B     &kp RIGHT    &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp MINUS
&kp C_MUTE &kp LCTRL &kp LGUI &kp LALT &kp SPACE &mo 1       &kp ENTER &kp ENTER &kp BSPC   &mo 2   &mo 3  &kp RSHFT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* ============ LAYER 1 : SYMBOLS ============ */
        /* every symbol is a single keypress (no Shift needed).
         * Best (home) positions -> symbols hardest to reach on BASE:
         *   row0  F1-F12
         *   row1  ! @ # $ % ^   & * : " < >          (Shift+base on BASE)
         *   row2  ` ~ = + _ |   ( ) [ ] { }          (unreachable on BASE)
         *   row3  - / \ ; ' ,   . ?                  (already direct on BASE)
         */
        symbols {
            display-name = "SYM";
            bindings = <
&kp F1     &kp F2    &kp F3    &kp F4    &kp F5    &kp F6                             &kp UP       &kp F7       &kp F8    &kp F9       &kp F10   &kp F11   &kp F12
&kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT &kp CARET                          &kp DOWN     &kp AMPS     &kp STAR  &kp COLON    &kp DQT   &kp LT    &kp GT
&kp GRAVE  &kp TILDE &kp EQUAL &kp PLUS  &kp UNDER &kp PIPE                           &kp LEFT     &kp LPAR     &kp RPAR  &kp LBKT     &kp RBKT  &kp LBRC  &kp RBRC
&kp MINUS  &kp FSLH  &kp BSLH  &kp SEMI  &kp APOS  &kp COMMA                          &kp RIGHT    &kp DOT       &kp QUESTION &trans     &trans    &trans    &trans
&trans     &trans    &trans    &trans    &trans    &trans                             &trans       &trans       &trans    &trans       &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* ============ LAYER 2 : NAVIGATION / VIM ============ */
        /* F-keys live on SYM, so the top-left row is a text-object cluster. */
        nav {
            display-name = "NAV";
            bindings = <
&vim_ci_dq &vim_ci_sq &vim_ci_paren &vim_ci_brack &vim_ci_brace &vim_va_brace &kp UP    &kp STAR &kp PG_UP &kp HOME &kp UP  &kp END   &kp PG_DN
&kp ESC    &trans    &trans        &trans        &trans        &trans          &kp DOWN  &vim_meth_prev &vim_meth_next &vim_fn_prev &vim_fn_next &kp LBRC &kp RBRC
&kp LCTRL  &vim_ciw  &vim_yank     &vim_paste    &vim_blackhole_d &trans        &kp LEFT  &kp HASH &kp PRCNT &vim_subst &kp EQUAL &vim_indent &vim_outdent
&kp LSHFT  &kp LC(O) &kp LC(I)     &vim_change_prev &vim_change_next &trans     &kp RIGHT &kp LC(FSLH) &kp LC(F) &kp LC(S) &kp LC(B) &kp LC(LS(P)) &kp DEL
&trans     &trans    &trans        &trans        &trans        &trans          &trans    &trans   &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /* ============ LAYER 3 : SYSTEM ============ */
        sys {
            display-name = "SYS";
            bindings = <
&trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp UP     &bt BT_CLR &bt BT_CLR_ALL &kp C_BRI_UP &kp C_BRI_DN &kp C_MUTE &trans
&trans     &out OUT_USB &out OUT_BLE &trans       &trans       &trans       &kp DOWN   &kp C_VOL_UP &kp C_VOL_DN &kp C_PREV &kp C_PLAY_PAUSE &kp C_NEXT &trans
&trans     &sys_reset  &bootloader  &trans       &trans       &trans       &kp LEFT   &kp PRINTSCREEN &kp C_AL_LOCK &trans &trans &trans &trans
&trans     &soft_off   &rgb_ug RGB_OFF &rgb_ug RGB_ON &rgb_ug RGB_EFF &rgb_ug RGB_BRI &kp RIGHT &trans &trans &trans &trans &rgb_ug RGB_BRD &trans
&trans     &trans      &trans        &trans       &trans       &trans       &trans     &trans     &trans         &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
